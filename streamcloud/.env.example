# Copy this to .env and fill in your values
# chmod 600 .env after filling it in

# ProtonVPN WireGuard private key
# Get from: ProtonVPN dashboard → Downloads → WireGuard config → generate a config
PROTON_WG_KEY=your_wireguard_private_key_here

# Jellyfin API key (fill in after Jellyfin is set up)
JELLYFIN_API_KEY=

# Sonarr API key (fill in after Sonarr is set up)
SONARR_API_KEY=

# Radarr API key (fill in after Radarr is set up)
RADARR_API_KEY=

# Immich API key (fill in after Immich is set up)
IMMICH_API_KEY=

# --- Auto-prune (scripts/prune-video.sh, scripts/disk-prune.sh) ---

# Jellyfin username whose watched-state drives prune decisions.
# Blank = use the first user returned by /Users (good for single-user setups).
JELLYFIN_USER=

# Layer A — daily watched-and-delete: drop items watched longer ago than this.
PRUNE_AGE_DAYS=14

# Layer B — hourly hard-ceiling guard for /srv/media/video.
HIGH_WATER_GB=95
LOW_WATER_GB=90

# Safety: 1 = log only, 0 = actually delete. Keep at 1 until you've reviewed
# at least one real `prune-video.sh` run and confirmed the matches look right.
DRY_RUN=1

# --- ListenBrainz auto-playlists (scripts/generate-listenbrainz-playlists.sh) ---

# Your ListenBrainz username (sign up at listenbrainz.org)
LISTENBRAINZ_USER=

# Navidrome credentials, used to map troi recommendations to your local files
# via the Subsonic API. Use the same admin user you created during Navidrome setup.
NAVIDROME_USER=
NAVIDROME_PASS=
NAVIDROME_URL=https://127.0.0.1:4533

LAST_FM_API_KEY=
LAST_FM_SECRET=

# Ingestion and Cleanup
SOURCE_DIR=
TARGET_DIR=
INPUT_DIR=
OUTPUT_DIR=
BATCH_SIZE=20
