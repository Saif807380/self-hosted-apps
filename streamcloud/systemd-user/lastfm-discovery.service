[Unit]
Description=Streamcloud — Daily Last.fm Discovery Playlist
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/streamcloud
ExecStart=%h/Projects/self-hosted-apps/streamcloud/scripts/lastfm-discovery.py
StandardOutput=append:%h/.local/state/streamcloud/lastfm-discovery.log
StandardError=append:%h/.local/state/streamcloud/lastfm-discovery.log
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=default.target
