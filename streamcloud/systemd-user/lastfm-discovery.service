[Unit]
Description=Streamcloud — Daily Last.fm Discovery Playlist
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/Projects/self-hosted-apps/streamcloud/scripts/lastfm-discovery.py
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=default.target
