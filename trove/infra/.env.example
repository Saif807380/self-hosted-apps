POSTGRES_USER=lms
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lms
POSTGRES_PORT=5432

REDIS_PORT=6379

BACKEND_PORT=8080
UPLOADS_DIR=/uploads

DATABASE_URL=postgres://lms:changeme@127.0.0.1:5432/lms?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379

# TLS — leave empty to disable (HTTP only)
# Run infra/generate-certs.sh first to create the cert files
TLS_CERT_FILE=
TLS_KEY_FILE=

IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Web push keys for sale alerts: run `make vapid` and paste the output.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# An https URL (or email) identifying this server to push services.
VAPID_SUBJECT=
