# Bulk work: OCR, screenshots, chat title generation, anything high-volume.
#
# The 2B keeps its KV cache in VRAM at this context, so it barely decays as the
# conversation fills -- roughly 7x the 4B's speed at 8K of real context. That
# speed, not its quality, is why it exists here.
#
# Build:  ollama create cortex-2b -f cortex-2b.Modelfile
# Verify: ollama show cortex-2b --parameters

FROM qwen3-vl:2b

PARAMETER num_ctx 16384
