# Secrets live in two files, one per container, rather than one shared file:
# podman passes an --env-file wholesale, so a single file would put the Gemini
# API key into SearXNG's environment -- a service whose whole job is making
# outbound requests to a few dozen third-party search engines.
#
# Both are covered by the root .gitignore. chmod 600 them after filling in.
#
#   cortex/.env.searxng
#   cortex/.env.open-webui
#
# Generate every secret below with: openssl rand -hex 32


# ============ cortex/.env.searxng ============

# SearXNG refuses to serve on its shipped default secret.
SEARXNG_SECRET=


# ============ cortex/.env.open-webui ============

# Signs session tokens. Changing it logs everyone out.
WEBUI_SECRET_KEY=

# Phase 3 only. Google AI Studio, free tier, no card:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
